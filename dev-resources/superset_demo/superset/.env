COMPOSE_PROJECT_NAME=superset

# Generate secret key using this command: openssl rand -base64 42
SECRET_KEY=6+QrAihvb1UBP9DcUEoZg18WecbxGXL4aRvvc7WhURNJ9rgi+2oISOpT
BABEL_DEFAULT_LOCALE=en
PUBLIC_ROLE_LIKE=Gamma

# database configurations
DATABASE_DB=superset
DATABASE_HOST=supersetdb
DATABASE_PASSWORD=superset
DATABASE_USER=superset

# database engine specific environment variables
# change the below if you prefers another database engine
DATABASE_PORT=5432
DATABASE_DIALECT=postgresql
POSTGRES_DB=superset
POSTGRES_USER=superset
POSTGRES_PASSWORD=superset

PYTHONPATH=/app/pythonpath

REDIS_HOST=redis
REDIS_PORT=6379

# FLASK_ENV=development
# SUPERSET_ENV=development
FLASK_ENV=production
SUPERSET_ENV=production
# SUPERSET_LOAD_EXAMPLES=yes
CYPRESS_CONFIG=false
SUPERSET_PORT=8088
HOST_PORT=8088

# Authentication. Override SUPERSET_AUTH_MODE=db to isolate Superset from Keycloak.
SUPERSET_AUTH_MODE=oauth
OAUTH_CLIENT_ID=superset
OAUTH_CLIENT_SECRET=SQp7KIc7ZuNpsTk594Aqs1xOuHXC9RpF
OAUTH_METADATA_URL=http://host.docker.internal:8081/auth/realms/test/.well-known/openid-configuration
OAUTH_USERINFO_URL=http://host.docker.internal:8081/auth/realms/test/protocol/openid-connect/userinfo

# Dashboard embed
SUPERSET_FEATURE_EMBEDDED_SUPERSET=true
